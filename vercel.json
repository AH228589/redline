{
  "headers": [
    {
      "source": "/app-version.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/redline.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Redline.apk\"" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/redline.ipa",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Redline.ipa\"" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
